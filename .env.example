# Environment variables for fraud-detection-platform
# Copy this file to .env and adjust values as needed

# Model artifacts directory (relative to project root)
MODELS_DIR=models

# Model file path (if different from default)
# MODEL_PATH=models/fraud_pipeline.pkl

# Metrics file path (if different from default)
# METRICS_PATH=models/metrics.json

# API host and port
API_HOST=0.0.0.0
API_PORT=8000

# Business cost parameters (optional, defaults used if not set)
# FALSE_POSITIVE_COST=10.0
# FALSE_NEGATIVE_MULTIPLIER=1.0